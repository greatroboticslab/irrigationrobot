PROGRAM MotorSequence
VAR
    // ── External Inputs ───────────────────────────────────────
    ESP_Command         : BOOL := FALSE;   // Rising edge = trigger move
    Stop_Motor          : BOOL := TRUE;    // FALSE = E-Stop / halt
    Motion_Complete     : BOOL := FALSE;   // Feedback from drive: move done

    // ── Motion Parameters ─────────────────────────────────────
    Position_Setpoint   : DINT := 10000;   // Travel distance in pulses
    Speed_Setpoint      : INT  := 100;     // Target RPM

    // ── Drive Outputs ─────────────────────────────────────────
    Motor_Enable        : BOOL := FALSE;   // Enable signal to drive
    Target_Position     : DINT := 0;       // Commanded position sent to drive
    Target_Speed        : INT  := 0;       // Commanded speed sent to drive

    // ── Internal State Machine ────────────────────────────────
    Step                : INT  := 0;       // Current sequence step
    Move_Triggered      : BOOL := FALSE;   // Prevents re-triggering mid-move

    // ── Direction Toggle ──────────────────────────────────────
    Go_Forward          : BOOL := TRUE;    // TRUE = forward, FALSE = reverse

    // ── Edge Detection ────────────────────────────────────────
    ESP_Last            : BOOL := FALSE;   // Previous scan value of ESP_Command
    ESP_Rising          : BOOL := FALSE;   // One-shot rising edge pulse
END_VAR

// =============================================================
// EDGE DETECTION — One-shot on ESP_Command rising edge
// Prevents continuous re-triggering while signal stays TRUE
// =============================================================
ESP_Rising := ESP_Command AND NOT ESP_Last;
ESP_Last   := ESP_Command;

// =============================================================
// TRIGGER CAPTURE — Latch the rising edge into the state machine
// Only accepted when idle (Step = 0) and not already moving
// =============================================================
IF ESP_Rising AND NOT Move_Triggered AND (Step = 0) THEN
    Move_Triggered := TRUE;
    Step := 100;
END_IF;

// =============================================================
// EMERGENCY / NORMAL STOP — Overrides everything
// Stop_Motor = FALSE means halt commanded
// =============================================================
IF NOT Stop_Motor THEN
    Motor_Enable   := FALSE;
    Target_Speed   := 0;
    Move_Triggered := FALSE;
    Step           := 0;
    // NOTE: Drive should also receive a halt/disable command here
END_IF;

// =============================================================
// STATE MACHINE
// =============================================================
IF Stop_Motor THEN   // Only run states if not stopped

    CASE Step OF

        // ── STEP 0: IDLE ──────────────────────────────────────
        0:
            Motor_Enable := FALSE;
            Target_Speed := 0;
            // Waiting for Move_Triggered (set above)

        // ── STEP 100: CONFIGURE ───────────────────────────────
        // Set direction and load parameters into drive outputs
        100:
            IF Go_Forward THEN
                Target_Position := Position_Setpoint;   // e.g. +10000 pulses
            ELSE
                Target_Position := 0;                   // Return to home/origin
            END_IF;

            Target_Speed := Speed_Setpoint;
            Step := 200;

        // ── STEP 200: ENABLE DRIVE & COMMAND MOVE ────────────
        200:
            Motor_Enable := TRUE;
            // At this step your drive should receive Target_Position
            // and Target_Speed and begin executing the move
            Step := 300;

        // ── STEP 300: WAIT FOR MOTION COMPLETE ───────────────
        // Poll Motion_Complete feedback from drive
        300:
            IF Motion_Complete THEN
                Step := 400;
            END_IF;

        // ── STEP 400: FINALIZE ────────────────────────────────
        // Toggle direction for next command, reset flags, go idle
        400:
            Go_Forward     := NOT Go_Forward;  // Flip for next ESP trigger
            Motor_Enable   := FALSE;
            Move_Triggered := FALSE;
            Motion_Complete := FALSE;          // Clear feedback latch if needed
            Step           := 0;              // Back to IDLE, ready for next command

    END_CASE;

END_IF;

END_PROGRAM
